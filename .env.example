DATABASE_URL=postgresql://go_router:go_router@127.0.0.1:5432/go_router
# MIGRATION_DATABASE_URL can use a direct database endpoint while DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
PUBLIC_BASE_URL=http://go.localhost
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=20
